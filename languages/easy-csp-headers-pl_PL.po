#. Plugin Name of the plugin
#: easy-csp-headers.php
msgid "Easy CSP Headers"
msgstr "Easy CSP Headers"

#. Plugin URI of the plugin
#: easy-csp-headers.php
msgid "https://headwall-hosting.com/plugins/easy-csp-headers/"
msgstr "https://headwall-hosting.com/plugins/easy-csp-headers/"

#. Description of the plugin
#: easy-csp-headers.php
msgid "Automatically generate and inject Content Security Policy (CSP) headers with nonces for enhanced security."
msgstr "Automatycznie generuj i dodawaj nagłówki Content Security Policy (CSP) wraz z wartościami losowymi (nonces) w celu zwiększenia bezpieczeństwa."

#. Author of the plugin
#: easy-csp-headers.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: easy-csp-headers.php
msgid "https://headwall-hosting.com/a-web-guys-blog/"
msgstr "https://headwall-hosting.com/a-web-guys-blog/"

#: admin-templates/settings-page.php:23
msgid "General"
msgstr "Ogólne informacje"

#: admin-templates/settings-page.php:27
msgid "CSP Rules"
msgstr "Zasady CSP"

#: admin-templates/settings-page.php:31
msgid "Exclusions"
msgstr "Wyłączenia"

#: admin-templates/settings-page.php:35
msgid "Help"
msgstr "Pomoc"

#: admin-templates/tabs/csp-rules-tab.php:22
msgid "Use Strict-Dynamic"
msgstr "Użyj trybu Strict-Dynamic"

#: admin-templates/tabs/csp-rules-tab.php:32
msgid "Use 'strict-dynamic' in script-src directive"
msgstr "Użyj atrybutu „strict-dynamic” w dyrektywie script-src"

#: admin-templates/tabs/csp-rules-tab.php:36
msgid "Recommended for best security. Allows scripts loaded by trusted scripts."
msgstr "Zalecane w celu zapewnienia najwyższego poziomu bezpieczeństwa. Zezwala na ładowanie skryptów przez zaufane skrypty."

#: admin-templates/tabs/csp-rules-tab.php:43
msgid "Omit Unsafe-Inline Fallback"
msgstr "Pomiń niebezpieczne rozwiązanie awaryjne typu inline"

#: admin-templates/tabs/csp-rules-tab.php:53
msgid "Remove 'unsafe-inline' from the script-src directive"
msgstr "Usuń atrybut „unsafe-inline” z dyrektywy script-src"

#: admin-templates/tabs/csp-rules-tab.php:57
msgid "Current browsers already ignore 'unsafe-inline' when a nonce is present. It only matters to very old browsers without nonce support, where removing it blocks every inline script."
msgstr "Obecne przeglądarki już teraz ignorują atrybut „unsafe-inline”, gdy obecny jest nonce. Ma to znaczenie jedynie w przypadku bardzo starych przeglądarek, które nie obsługują nonce’ów – w takich przypadkach usunięcie tego atrybutu blokuje wszystkie skrypty wbudowane."

#: admin-templates/tabs/csp-rules-tab.php:83
msgid "Remove the http: and https: sources added alongside strict-dynamic"
msgstr "Usuń źródła zaczynające się od „http:” i „https:”, dodane wraz z opcją „strict-dynamic”"

#: admin-templates/tabs/csp-rules-tab.php:87
msgid "Browsers that support strict-dynamic ignore these. On older browsers without it (such as Safari before 15.4), removing them blocks scripts that trusted scripts load, such as analytics and chat widgets. Only applies when Use Strict-Dynamic is on."
msgstr "Przeglądarki obsługujące opcję „strict-dynamic” ignorują te elementy. W starszych przeglądarkach, które nie obsługują tej opcji (np. w Safari w wersji starszej niż 15.4), ich usunięcie blokuje skrypty ładowane przez zaufane skrypty, takie jak narzędzia analityczne i widżety czatu. Działa to tylko wtedy, gdy opcja „Use Strict-Dynamic” jest włączona."

#: admin-templates/tabs/csp-rules-tab.php:104
msgid "Add nonces to <style> tags and include style-src directive"
msgstr "Dodaj wartości nonce do tagów <style> i uwzględnij dyrektywę style-src"

#: admin-templates/tabs/csp-rules-tab.php:108
msgid "Enable if you want to restrict inline styles as well as scripts."
msgstr "Włącz tę opcję, jeśli chcesz ograniczyć stosowanie zarówno stylów wbudowanych, jak i skryptów."

#: admin-templates/tabs/csp-rules-tab.php:115
msgid "Whitelisted Domains"
msgstr "Domeny z białej listy"

#: admin-templates/tabs/csp-rules-tab.php:125
msgid "Add trusted domains (one per line). Example: https://cdn.example.com"
msgstr "Dodaj zaufane domeny (po jednej w każdym wierszu). Przykład: https://cdn.example.com"

#: admin-templates/tabs/csp-rules-tab.php:132
msgid "Custom CSP Directives"
msgstr "Niestandardowe dyrektywy CSP"

#: admin-templates/tabs/csp-rules-tab.php:142
msgid "Add custom CSP directives (one per line). Example: img-src * data:"
msgstr "Dodaj niestandardowe dyrektywy CSP (po jednej w każdym wierszu). Przykład: img-src * data:"

#: admin-templates/tabs/csp-rules-tab.php:149
msgid "Report URI"
msgstr "Adres URI raportu"

#: admin-templates/tabs/csp-rules-tab.php:159
msgid "URL where CSP violation reports should be sent."
msgstr "Adres URL, na który należy przesyłać zgłoszenia dotyczące naruszeń CSP."

#: admin-templates/tabs/exclusions-tab.php:22
msgid "Excluded Paths"
msgstr "Wykluczone ścieżki"

#: admin-templates/tabs/exclusions-tab.php:32
msgid "Paths to exclude from CSP processing (one per line). Examples:"
msgstr "Ścieżki, które należy wykluczyć z przetwarzania CSP (po jednej w każdym wierszu). Przykłady:"

#: admin-templates/tabs/general-tab.php:23
#: admin-templates/tabs/help-tab.php:53
#: includes/class-admin-hooks.php:149
msgid "Enable CSP Headers"
msgstr "Włącz nagłówki CSP"

#: admin-templates/tabs/general-tab.php:30
msgid "Enable Content Security Policy processing"
msgstr "Włącz przetwarzanie zasad bezpieczeństwa treści (CSP)"

#: admin-templates/tabs/general-tab.php:34
msgid "Master switch to enable or disable CSP header injection."
msgstr "Przełącznik główny służący do włączania lub wyłączania wstawiania nagłówków CSP."

#: admin-templates/tabs/general-tab.php:41
msgid "CSP Mode"
msgstr "Tryb CSP"

#: admin-templates/tabs/general-tab.php:48
msgid "Report-Only (violations logged, not blocked)"
msgstr "Tylko zgłoszenie (naruszenia są rejestrowane, ale nie powodują blokady)"

#: admin-templates/tabs/general-tab.php:54
msgid "Enforce (violations blocked)"
msgstr "Egzekwuj (naruszenia zablokowane)"

#: admin-templates/tabs/general-tab.php:58
msgid "Start with Report-Only mode to test without breaking your site."
msgstr "Zacznij od trybu „Tylko raport”, aby przeprowadzić testy bez zakłócania działania witryny."

#: admin-templates/tabs/general-tab.php:65
msgid "Enable for Logged-in Users"
msgstr "Włącz dla zalogowanych użytkowników"

#: admin-templates/tabs/general-tab.php:75
msgid "Apply CSP headers when users are logged in"
msgstr "Stosuj nagłówki CSP, gdy użytkownicy są zalogowani"

#: admin-templates/tabs/general-tab.php:79
msgid "By default, CSP is disabled for logged-in users. Enable this to test while authenticated."
msgstr "Domyślnie funkcja CSP jest wyłączona dla zalogowanych użytkowników. Włącz tę opcję, aby przeprowadzić testy po uwierzytelnieniu."

#: admin-templates/tabs/general-tab.php:86
msgctxt "settings row label for data deletion on plugin removal"
msgid "Uninstall"
msgstr "Odinstaluj"

#: admin-templates/tabs/general-tab.php:96
msgid "Delete all plugin data when uninstalled"
msgstr "Usuń wszystkie dane wtyczki po jej odinstalowaniu"

#: admin-templates/tabs/general-tab.php:100
msgid "When the plugin is deleted from the Plugins screen, remove all of its settings. Deactivating the plugin never deletes anything."
msgstr "Po usunięciu wtyczki z ekranu „Wtyczki” należy usunąć wszystkie jej ustawienia. Dezaktywacja wtyczki nigdy nie powoduje usunięcia żadnych danych."

#: admin-templates/tabs/general-tab.php:109
msgid "Verify that CSP headers are being sent correctly by your server."
msgstr "Sprawdź, czy serwer prawidłowo wysyła nagłówki CSP."

#: admin-templates/tabs/help-tab.php:16
msgid "What is Content Security Policy (CSP)?"
msgstr "Czym jest polityka bezpieczeństwa treści (CSP)?"

#: admin-templates/tabs/help-tab.php:19
msgid "Content Security Policy is a security feature that helps prevent cross-site scripting (XSS) attacks by controlling which resources can be loaded and executed on your website."
msgstr "Polityka bezpieczeństwa treści (Content Security Policy) to funkcja zabezpieczająca, która pomaga zapobiegać atakom typu cross-site scripting (XSS) poprzez kontrolowanie, jakie zasoby mogą być ładowane i wykonywane w Twojej witrynie."

#: admin-templates/tabs/help-tab.php:23
msgid "How Nonces Work"
msgstr "Jak działają nonce"

#: admin-templates/tabs/help-tab.php:26
msgid "This plugin generates a unique nonce (random value) for each page load and adds it to all script and style tags. The same nonce is included in the CSP header, allowing only scripts with matching nonces to execute."
msgstr "Ta wtyczka generuje unikalny identyfikator (wartość losową) przy każdym załadowaniu strony i dodaje go do wszystkich tagów skryptów i arkuszy stylów. Ten sam identyfikator jest umieszczany w nagłówku CSP, co pozwala na wykonywanie wyłącznie skryptów o pasujących identyfikatorach."

#: admin-templates/tabs/help-tab.php:30
msgid "Understanding CSP Modes"
msgstr "Zrozumienie trybów pracy CSP"

#: admin-templates/tabs/help-tab.php:31
msgid "Report-Only Mode"
msgstr "Tryb wyłącznie do przeglądania"

#: admin-templates/tabs/help-tab.php:34
msgid "In Report-Only mode, CSP violations are logged to the browser console but NOT blocked. This is the safe way to test CSP without breaking your site. Use this mode to identify issues before enforcing the policy."
msgstr "W trybie „tylko raportowanie” naruszenia CSP są rejestrowane w konsoli przeglądarki, ale NIE są blokowane. Jest to bezpieczny sposób na przetestowanie CSP bez zakłócania działania witryny. Skorzystaj z tego trybu, aby zidentyfikować problemy przed wdrożeniem polityki."

#: admin-templates/tabs/help-tab.php:38
#: includes/class-admin-hooks.php:122
msgid "Important:"
msgstr "Ważne:"

#: admin-templates/tabs/help-tab.php:39
msgid "Report-Only mode does NOT provide security protection. It only logs violations. You must switch to Enforce mode to actually block malicious scripts."
msgstr "Tryb „Tylko raportowanie” NIE zapewnia ochrony bezpieczeństwa. Służy on wyłącznie do rejestrowania naruszeń. Aby faktycznie blokować złośliwe skrypty, należy przełączyć się na tryb „Egzekwowanie”."

#: admin-templates/tabs/help-tab.php:42
msgid "Enforce Mode"
msgstr "Tryb egzekwowania"

#: admin-templates/tabs/help-tab.php:45
msgid "In Enforce mode, CSP violations are actively blocked by the browser. This provides full security protection but may break functionality if CSP rules are too strict. Always test in Report-Only mode first."
msgstr "W trybie „Enforce” przeglądarka aktywnie blokuje naruszenia CSP. Zapewnia to pełną ochronę bezpieczeństwa, ale może spowodować zakłócenia w działaniu, jeśli reguły CSP są zbyt rygorystyczne. Zawsze najpierw przeprowadzaj testy w trybie „Report-Only”."

#: admin-templates/tabs/help-tab.php:49
msgid "Getting Started - Step by Step"
msgstr "Pierwsze kroki – krok po kroku"

#: admin-templates/tabs/help-tab.php:54
msgid "Turn on the master toggle in the General tab"
msgstr "Włącz główny przełącznik w zakładce „Ogólne”"

#: admin-templates/tabs/help-tab.php:58
msgid "Start with Report-Only mode"
msgstr "Zacznij od trybu „Tylko raport”"

#: admin-templates/tabs/help-tab.php:59
msgid "This will log violations without breaking your site"
msgstr "Dzięki temu naruszenia będą rejestrowane bez zakłócania działania Twojej strony"

#: admin-templates/tabs/help-tab.php:63
msgid "Clear your cache"
msgstr "Wyczyść pamięć podręczną"

#: admin-templates/tabs/help-tab.php:64
msgid "If using a caching plugin, clear it now"
msgstr "Jeśli korzystasz z wtyczki buforującej, wyczyść ją teraz"

#: admin-templates/tabs/help-tab.php:68
msgid "Check browser console"
msgstr "Sprawdź konsolę przeglądarki"

#: admin-templates/tabs/help-tab.php:69
msgid "Visit your site and open Developer Tools (F12) to see CSP violation reports"
msgstr "Wejdź na swoją stronę i otwórz Narzędzia programistyczne (F12), aby wyświetlić raporty dotyczące naruszeń CSP"

#: admin-templates/tabs/help-tab.php:73
msgid "Fix violations"
msgstr "Napraw naruszenia"

#: admin-templates/tabs/help-tab.php:74
msgid "Add trusted domains to the whitelist or exclude problematic pages"
msgstr "Dodaj zaufane domeny do białej listy lub wyklucz problematyczne strony"

#: admin-templates/tabs/help-tab.php:78
msgid "Switch to Enforce mode"
msgstr "Przełącz na tryb wymuszania"

#: admin-templates/tabs/help-tab.php:79
msgid "Once no violations appear, change CSP Mode to \"Enforce\" for full protection"
msgstr "Gdy nie pojawią się żadne naruszenia, zmień tryb CSP na „Enforce”, aby zapewnić pełną ochronę"

#: admin-templates/tabs/help-tab.php:83
msgid "Clear cache again"
msgstr "Ponownie wyczyść pamięć podręczną"

#: admin-templates/tabs/help-tab.php:84
msgid "Always clear your cache after changing settings"
msgstr "Po zmianie ustawień zawsze należy wyczyścić pamięć podręczną"

#: admin-templates/tabs/help-tab.php:89
msgid "Common Issues"
msgstr "Typowe problemy"

#: admin-templates/tabs/help-tab.php:90
msgid "Inline Event Handlers"
msgstr "Obsługa zdarzeń w kodzie"

#: admin-templates/tabs/help-tab.php:93
msgid "Inline event handlers like onclick=\"...\" will be blocked by strict CSP. These should be updated to use addEventListener() instead."
msgstr "Obsługa zdarzeń w kodzie, np. onclick=\"...\", będzie blokowana przez ścisłą politykę CSP. Należy je zmienić tak, aby zamiast tego korzystały z funkcji addEventListener()."

#: admin-templates/tabs/help-tab.php:96
msgid "External Scripts"
msgstr "Skrypty zewnętrzne"

#: admin-templates/tabs/help-tab.php:99
msgid "With strict-dynamic enabled, external scripts loaded by trusted scripts will automatically be allowed. You can also add specific domains to the whitelist."
msgstr "Po włączeniu trybu „strict-dynamic” skrypty zewnętrzne ładowane przez zaufane skrypty będą automatycznie dopuszczane. Można również dodać konkretne domeny do białej listy."

#: admin-templates/tabs/help-tab.php:102
msgid "Legacy Browser Fallbacks"
msgstr "Rozwiązania awaryjne dla starszych przeglądarek"

#: admin-templates/tabs/help-tab.php:105
msgid "By default the script-src directive includes 'unsafe-inline' and, with strict-dynamic, http: and https:. Current browsers ignore all three, so they only loosen the policy on old browsers that would otherwise break. The two Omit options on the CSP Rules tab remove them for a shorter, strict policy everywhere, at the cost of broken scripts on those old browsers. Test in Report-Only mode first."
msgstr "Domyślnie dyrektywa `script-src` obejmuje opcję `unsafe-inline` oraz, w połączeniu z opcją `strict-dynamic`, protokoły `http:` i `https:`. Obecne przeglądarki ignorują wszystkie trzy, więc łagodzą one zasady tylko w przypadku starszych przeglądarek, w których w przeciwnym razie wystąpiłyby błędy. Dwie opcje „Omit” na karcie „CSP Rules” usuwają je, zapewniając wszędzie krótszą, rygorystyczną politykę, kosztem nieprawidłowego działania skryptów w tych starszych przeglądarkach. Najpierw przetestuj w trybie „Report-Only”."

#: admin-templates/tabs/help-tab.php:108
msgid "Caching"
msgstr "Buforowanie"

#: admin-templates/tabs/help-tab.php:111
msgid "This plugin works with page caching plugins. The nonce is generated when the cache is built and remains consistent until the cache is cleared."
msgstr "Ta wtyczka współpracuje z wtyczkami do buforowania stron. Kod jednorazowy jest generowany podczas tworzenia pamięci podręcznej i pozostaje niezmienny do momentu jej wyczyszczenia."

#: admin-templates/tabs/help-tab.php:115
msgid "Critical:"
msgstr "Ważne:"

#: admin-templates/tabs/help-tab.php:116
msgid "After changing ANY setting on this page, you MUST clear your page cache for the changes to take effect. If you do not see changes, check your admin bar for CSP status notifications."
msgstr "Po zmianie DOWOLNEGO ustawienia na tej stronie NALEŻY wyczyścić pamięć podręczną strony, aby zmiany zaczęły obowiązywać. Jeśli zmiany nie są widoczne, sprawdź pasek administratora pod kątem powiadomień o statusie CSP."

#: admin-templates/tabs/help-tab.php:120
msgid "Path Exclusions"
msgstr "Wykluczenia ścieżek"

#: admin-templates/tabs/help-tab.php:123
msgid "You can exclude specific paths from CSP processing using exact matches or wildcard patterns:"
msgstr "Można wykluczyć określone ścieżki z przetwarzania CSP, stosując dokładne dopasowania lub wzorce z symbolami wieloznacznymi:"

#: admin-templates/tabs/help-tab.php:128
msgid "Exact match:"
msgstr "Dokładne dopasowanie:"

#: admin-templates/tabs/help-tab.php:129
msgid "- Only matches exactly /checkout/"
msgstr "- Dopuszcza się wyłącznie dokładne dopasowanie do /checkout/"

#: admin-templates/tabs/help-tab.php:133
msgid "Wildcard:"
msgstr "Znak wieloznaczny:"

#: admin-templates/tabs/help-tab.php:134
msgid "- Matches /checkout/ and all subpages"
msgstr "- Odpowiada /checkout/ i wszystkim podstronom"

#: admin-templates/tabs/help-tab.php:138
msgid "Example:"
msgstr "Przykład:"

#: admin-templates/tabs/help-tab.php:139
msgid "- Exclude entire admin area"
msgstr "- Wyklucz cały obszar administracyjny"

#: admin-templates/tabs/help-tab.php:144
msgid "Developer Hooks"
msgstr "Hooki programistyczne"

#: admin-templates/tabs/help-tab.php:147
msgid "Developers can programmatically control CSP processing using the ecsp_should_skip_csp filter:"
msgstr "Programiści mogą programowo sterować przetwarzaniem CSP za pomocą filtra `ecsp_should_skip_csp`:"

#: includes/class-admin-hooks.php:35
msgid "Settings"
msgstr "Ustawienia"

#: includes/class-admin-hooks.php:53
msgid "CSP Headers"
msgstr "Nagłówki CSP"

#: includes/class-admin-hooks.php:123
msgid "If you use a page caching plugin, clear your cache now for the new CSP settings to take effect."
msgstr "Jeśli korzystasz z wtyczki do buforowania stron, wyczyść teraz pamięć podręczną, aby nowe ustawienia CSP zaczęły obowiązywać."

#: includes/class-admin-hooks.php:146
#: includes/class-admin-hooks.php:158
msgid "CSP Headers:"
msgstr "Nagłówki CSP:"

#: includes/class-admin-hooks.php:147
msgid "Content Security Policy headers are currently disabled."
msgstr "Nagłówki Content Security Policy są obecnie wyłączone."

#: includes/class-admin-hooks.php:159
msgid "CSP is in Report-Only mode and NOT providing security protection. Violations are logged but not blocked."
msgstr "System CSP działa w trybie wyłącznie raportowania i NIE zapewnia ochrony bezpieczeństwa. Naruszenia są rejestrowane, ale nie są blokowane."

#: includes/class-admin-hooks.php:161
msgid "Switch to Enforce Mode"
msgstr "Przełącz na tryb wymuszania"

#: includes/class-admin-hooks.php:190
msgid "CSP Headers Disabled"
msgstr "Nagłówki CSP wyłączone"

#: includes/class-admin-hooks.php:194
msgid "Click to enable CSP Headers"
msgstr "Kliknij, aby włączyć nagłówki CSP"

#: includes/class-admin-hooks.php:208
msgid "CSP: Report-Only Mode"
msgstr "CSP: Tryb wyłącznie raportowania"

#: includes/class-admin-hooks.php:212
msgid "Switch to Enforce mode for full protection"
msgstr "Przełącz się na tryb „Enforce”, aby zapewnić pełną ochronę"

#: includes/class-admin-hooks.php:230
msgid "Insufficient permissions."
msgstr "Brak odpowiednich uprawnień."

#. translators: %s: Error message
#: includes/class-admin-hooks.php:251
#, php-format
msgid "Request failed: %s"
msgstr "Żądanie nie powiodło się: %s"

#: includes/class-admin-hooks.php:286
msgid "You do not have sufficient permissions to access this page."
msgstr "Nie masz wystarczających uprawnień, aby uzyskać dostęp do tej strony."

#. translators: %s is a list of CSP source keywords, http: and https:, shown as they are
#: admin-templates/tabs/csp-rules-tab.php:69
#, php-format
msgid "Omit %s Fallback"
msgstr "Pomiń %s – opcja awaryjna"

#: admin-templates/tabs/general-tab.php:108
#: admin-templates/tabs/general-tab.php:112
msgctxt "button and section label: run a check that the server sends the CSP headers"
msgid "Test CSP Headers"
msgstr "Test nagłówków CSP"

#: admin-templates/tabs/csp-rules-tab.php:94
msgid "Add Nonces to Styles"
msgstr "Dodaj wartości nonce do stylów"
